# Copy to .env and fill in only the model credentials you use.

# Jira credentials. Optional if ~/.config/jira-mcp/.env already exists.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token

# OpenAI models.
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini models. GOOGLE_API_KEY also works.
GOOGLE_GEMINI_API_KEY=your-google-gemini-key
GOOGLE_API_KEY=your-google-api-key

# Ollama models.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_THINK=false

# Analysis prompt sizing. Export JSON still keeps full descriptions.
TASK_SORTER_MAX_DESCRIPTION_CHARS=2500
TASK_SORTER_CHUNK_SIZE=5
